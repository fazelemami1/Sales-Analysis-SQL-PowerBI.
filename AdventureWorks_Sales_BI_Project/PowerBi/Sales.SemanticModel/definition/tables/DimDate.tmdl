	column IsCurrentMonth
		formatString: 0
		lineageTag: 440394dd-e4a8-4d63-a374-038148c4fef0
		summarizeBy: none
		isNameInferred
		sourceColumn: [IsCurrentMonth]

		annotation SummarizationSetBy = Automatic

	partition DimDate = calculated
		mode: import
		source =
				
				VAR StartDate = DATE(2000, 1, 1)
				VAR EndDate = DATE(2025, 12, 31)
				RETURN
				ADDCOLUMNS(
				    CALENDAR(StartDate, EndDate),
				    "Year", YEAR([Date]),
				    "Month Number", MONTH([Date]),
				    "Month Name", FORMAT([Date], "MMMM"),
				    "Month Short", FORMAT([Date], "MMM"),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "Year Month", FORMAT([Date], "YYYY-MM"),
				    "YearMonthKey", YEAR([Date]) * 100 + MONTH([Date]),
				    "Weekday", FORMAT([Date], "dddd"),
				    "Day Number", WEEKDAY([Date], 2), -- Starts Monday
				    "IsCurrentYear", IF(YEAR([Date]) = YEAR(TODAY()), 1, 0),
				    "IsCurrentMonth", IF( YEAR([Date]) = YEAR(TODAY()) &&    MONTH([Date]) = MONTH(TODAY()),    1, 0)
				   )

	annotation PBI_Id = 39b7e090e84447afb29514f972452cad

